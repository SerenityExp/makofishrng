-- Shared hook state
local SA_mt = nil
local SA_old_nc = nil
local SA_old_index = nil
local SA_cleanup_fns = {}

local function SA_Cleanup()
    for _, fn in ipairs(SA_cleanup_fns) do pcall(fn) end
    SA_cleanup_fns = {}
end

local function SA_GetTarget()
    local ox, oy = GetAimOrigin()
    local tgt = NearestTarget(SA_FOV, SA_Part, SA_Team, SA_NPC, ox, oy)
    if not tgt then return nil end
    if SA_VisChk then
        local myHRP = HRP()
        if myHRP then
            local rp = RaycastParams.new()
            rp.FilterDescendantsInstances = {LP.Character}
            rp.FilterType = Enum.RaycastFilterType.Exclude
            local res = Workspace:Raycast(myHRP.Position, (tgt.Position - myHRP.Position), rp)
            if res and not tgt.Parent:IsAncestorOf(res.Instance) then return nil end
        end
    end
    return tgt
end

-- Method 1: Redirect Ray (high UNC — getrawmetatable + setreadonly)
-- Hooks __namecall, redirects FindPartOnRay/FindPartOnRayWithIgnoreList
local function SA_InstallRedirectRay()
    SA_Cleanup()
    if not getrawmetatable then return end
    local mt = pcall(getrawmetatable, game) and getrawmetatable(game)
    if not mt then return end
    local ok, old_nc = pcall(function() return mt.__namecall end)
    if not ok then return end
    SA_mt = mt; SA_old_nc = old_nc
    pcall(setreadonly, mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        if SA_On then
            local m = getnamecallmethod()
            if m == "FindPartOnRayWithIgnoreList" or m == "FindPartOnRay" then
                local tgt = SA_GetTarget()
                if tgt then
                    local args = {...}
                    if args[1] and type(args[1]) == "userdata" then
                        local origin = args[1].Origin
                        args[1] = Ray.new(origin, (tgt.Position - origin).Unit * 999)
                    end
                    return old_nc(self, table.unpack(args))
                end
            end
        end
        return old_nc(self, ...)
    end)
    pcall(setreadonly, mt, true)
    table.insert(SA_cleanup_fns, function()
        pcall(setreadonly, mt, false)
        mt.__namecall = old_nc
        pcall(setreadonly, mt, true)
    end)
end

-- Method 2: Mouse Origin (medium UNC — hookfunction on WorldRoot methods)
-- Redirects Workspace:FindPartOnRay at C-closure level
local SA_hook_conn = nil
local function SA_InstallHookFunction()
    SA_Cleanup()
    if not hookfunction then return end
    local orig = Workspace.FindPartOnRay
    local hooked = hookfunction(Workspace.FindPartOnRay, newcclosure(function(self, ray, ...)
        if SA_On then
            local tgt = SA_GetTarget()
            if tgt then
                ray = Ray.new(ray.Origin, (tgt.Position - ray.Origin).Unit * 999)
            end
        end
        return orig(self, ray, ...)
    end))
    table.insert(SA_cleanup_fns, function() pcall(hookfunction, Workspace.FindPartOnRay, hooked) end)
end

-- Method 3: Camera CFrame Spoof (medium UNC — no __namecall needed)
-- Briefly rotates camera to face target when shot is fired, then restores
local SA_spoof_active = false
local SA_spoof_conn = nil
local function SA_InstallCameraSpoof()
    SA_Cleanup()
    if SA_spoof_conn then SA_spoof_conn:Disconnect() end
    SA_spoof_conn = UserInput.InputBegan:Connect(function(inp, gpe)
        if gpe or not SA_On or SA_spoof_active then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        local tgt = SA_GetTarget(); if not tgt then return end
        SA_spoof_active = true
        local orig = Camera.CFrame
        local sp = Camera:WorldToViewportPoint(tgt.Position)
        local dir = (tgt.Position - Camera.CFrame.Position).Unit
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + dir)
        task.delay(0.07, function()
            pcall(function() Camera.CFrame = orig end)
            SA_spoof_active = false
        end)
    end)
    table.insert(SA_cleanup_fns, function()
        if SA_spoof_conn then SA_spoof_conn:Disconnect(); SA_spoof_conn = nil end
        SA_spoof_active = false
    end)
end

-- Method 4: Mouse Delta Correction (low UNC — pure mouse movement, no hooks)
-- Snaps mouse toward target on LMB down, fires, then snaps back
local SA_delta_conn = nil
local function SA_InstallMouseDelta()
    SA_Cleanup()
    if SA_delta_conn then SA_delta_conn:Disconnect() end
    SA_delta_conn = UserInput.InputBegan:Connect(function(inp, gpe)
        if gpe or not SA_On then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        local tgt = SA_GetTarget(); if not tgt then return end
        local ox, oy = GetAimOrigin()
        local sp, vis = Camera:WorldToViewportPoint(tgt.Position)
        if not vis then return end
        local dx, dy = sp.X - ox, sp.Y - oy
        mousemoverel(dx, dy)
        task.delay(0.05, function() mousemoverel(-dx, -dy) end)
    end)
    table.insert(SA_cleanup_fns, function()
        if SA_delta_conn then SA_delta_conn:Disconnect(); SA_delta_conn = nil end
    end)
end

-- Method 5: Raycast Override (high UNC — hooks WorldRoot:Raycast)
local function SA_InstallRaycastOverride()
    SA_Cleanup()
    if not hookfunction then return end
    local orig_rc = Workspace.Raycast
    local hooked = hookfunction(Workspace.Raycast, newcclosure(function(self, origin, direction, params)
        if SA_On then
            local tgt = SA_GetTarget()
            if tgt then
                direction = (tgt.Position - origin).Unit * direction.Magnitude
            end
        end
        return orig_rc(self, origin, direction, params)
    end))
    table.insert(SA_cleanup_fns, function() pcall(hookfunction, Workspace.Raycast, hooked) end)
end

local SA_MethodMap = {
    ["Redirect Ray (High UNC)"]        = SA_InstallRedirectRay,
    ["Hook FindPartOnRay (High UNC)"]  = SA_InstallHookFunction,
    ["Raycast Override (High UNC)"]    = SA_InstallRaycastOverride,
    ["Camera Spoof (Medium UNC)"]      = SA_InstallCameraSpoof,
    ["Mouse Delta (Low UNC)"]          = SA_InstallMouseDelta,
}

local function SA_SetMethod(name)
    SA_Method = name
    SA_On = false
    SA_Cleanup()
    local fn = SA_MethodMap[name]
    if fn then pcall(fn) end
end

