            if kb and kb.Value ~= "" and kb.Value ~= "None" and not kb.Toggled then return end
        end
        local ox, oy = GetAimOrigin()
        -- KO check
        if TB.KOCheck then
            if TB_KOTarget then
                local h = TB_KOTarget.Parent and TB_KOTarget.Parent:FindFirstChildOfClass("Humanoid")
                if not h or h.Health <= 0 then TB_KODead = true; TB_KOTarget = nil; return end
            end
        end
        -- Prediction-adjusted FOV: check if predicted position is within FOV
        local effectiveFOV = TB.FOV / math.max(1, TB.Smooth)
        local tgt = NearestTarget(effectiveFOV, TB.Hitpart, TB.Team, TB.NPC, ox, oy)
        if not tgt then return end
        -- Apply prediction: verify predicted position is still in cone
        if TB.Pred > 0 then
            local vel = tgt.AssemblyLinearVelocity or Vector3.zero
            local pred = tgt.Position + vel * (TB.Pred * 0.016)
            local sp, vis = Camera:WorldToViewportPoint(pred)
            if not vis then return end
            local d = Vector2.new(sp.X - ox, sp.Y - oy).Magnitude
            if d > effectiveFOV then return end
        end
        if TB.VisChk then
            local myHRP = HRP()
            if myHRP then
                local rp = RaycastParams.new(); rp.FilterDescendantsInstances = {LP.Character}; rp.FilterType = Enum.RaycastFilterType.Exclude
                local res = Workspace:Raycast(myHRP.Position, (tgt.Position - myHRP.Position), rp)
                if res and not tgt.Parent:IsAncestorOf(res.Instance) then return end
            end
        end
        if TB.KOCheck then TB_KOTarget = tgt end
        TB.Busy = true
        task.delay(TB.Delay, function()
            if TB.On then mouse1click() end
            TB.Busy = false
        end)
    end)

    -- ── Hitbox Expander ───────────────────────────────────────────
    local S4 = P.Combat:Section({ Name = "Hitbox", Icon = "", Side = 2 })
    local HBX = { On = false, Size = 6, Team = true, NPC = false }
    S4:Toggle({ Name = "Enabled", Flag = "HBX_On", Default = false,
        Callback = function(v)
            HBX.On = v
            if not v then
                for _, p in Players:GetPlayers() do
                    if p == LP then continue end
                    local ch = p.Character
                    if ch then local h = ch:FindFirstChild("HumanoidRootPart"); if h then h.Size = Vector3.new(2,2,1) end end
                end
            end
        end })
    S4:Slider({ Name = "Size", Flag = "HBX_Size", Min = 2, Max = 30, Default = 6, Callback = function(v) HBX.Size = v end })
    S4:Toggle({ Name = "Team Check",    Flag = "HBX_Team", Default = true,  Callback = function(v) HBX.Team = v end })
    S4:Toggle({ Name = "NPC Targeting", Flag = "HBX_NPC",  Default = false, Callback = function(v) HBX.NPC = v end })
    RunService.Heartbeat:Connect(function()
        if not HBX.On then return end
        for _, p in Players:GetPlayers() do
            if p == LP then continue end
            if HBX.Team and p.Team == LP.Team then continue end
            local ch = p.Character; if not ch then continue end
            local h = ch:FindFirstChild("HumanoidRootPart")
            if h and h.Size.X < HBX.Size then h.Size = Vector3.new(HBX.Size,HBX.Size,HBX.Size) end
        end
        if HBX.NPC then
            for _, model in ipairs(Workspace:GetChildren()) do
                if not model:IsA("Model") or Players:GetPlayerFromCharacter(model) then continue end
                local hum = model:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health <= 0 then continue end
                local hrp = model:FindFirstChild("HumanoidRootPart")
                if hrp and hrp.Size.X < HBX.Size then hrp.Size = Vector3.new(HBX.Size,HBX.Size,HBX.Size) end
            end
        end
    end)

    -- ── Anti-Aim ─────────────────────────────────────────────────
    local S5 = P.Combat:Section({ Name = "Anti-Aim", Icon = "", Side = 2 })
    local AA = { On = false, Mode = "Spin", Speed = 12, Yaw = 0 }
    S5:Toggle({ Name = "Enabled", Flag = "AA_On", Default = false, Callback = function(v) AA.On = v end })
    S5:Dropdown({ Name = "Mode", Flag = "AA_Mode",
        Items = { "Spin", "Jitter", "Static 180", "Desync" }, Default = "Spin",
        Callback = function(v) AA.Mode = v or "Spin" end })
    S5:Slider({ Name = "Speed", Flag = "AA_Speed", Min = 1, Max = 60, Default = 12, Callback = function(v) AA.Speed = v end })
    RunService.RenderStepped:Connect(function()
        if not AA.On then return end
        local hrp = HRP(); if not hrp then return end
        if AA.Mode == "Spin" then
            AA.Yaw = (AA.Yaw + AA.Speed) % 360
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(AA.Yaw), 0)
        elseif AA.Mode == "Jitter" then
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(math.random(-180,180)), 0)
        elseif AA.Mode == "Static 180" then
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(180), 0)
        elseif AA.Mode == "Desync" then
            AA.Yaw = (AA.Yaw + AA.Speed * 2) % 360
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(math.rad(math.sin(AA.Yaw)*25), math.rad(AA.Yaw), 0)
        end
    end)

    -- ── Reach Extender ────────────────────────────────────────────
    local S6 = P.Combat:Section({ Name = "Reach", Icon = "", Side = 1 })
