        Callback = function(v)
            EF.On = v
            if not v then for _, o in pairs(ESPObjs) do HideESP(o) end end
        end })
    S1:Toggle({ Name = "NPC Targeting", Flag = "ESP_NPC", Default = false,
        Callback = function(v) EF.NPC = v end })
