    S1:Toggle({ Name = "Team Colour",  Flag = "_ESPT" }):Colorpicker({ Name = "Team", Flag = "ESP_TC",
        Default = Color3.fromRGB(80,220,80),  Alpha = 0, Callback = function(c) EF.TCol = c end })

    -- Chams (Highlight - through walls via DepthMode.AlwaysOnTop)
    local S2 = P.Visuals:Section({ Name = "Chams (Highlight)", Icon = "", Side = 2 })

    local CH = {
        On = false, Team = false, WallCheck = false,
        FillCol = Color3.fromRGB(75,156,211), OutCol = Color3.fromRGB(255,255,255),
        FillAlpha = 0.5, OutAlpha = 0,
    }
    local Highlights = {}

    local function ApplyHL(char, visible)
        if not char then return end
        if not visible then
            if Highlights[char] then
                pcall(function() Highlights[char]:Destroy() end)
                Highlights[char] = nil
            end
            return
        end
        if not Highlights[char] or not Highlights[char].Parent then
            local h = Instance.new("Highlight")
            h.FillColor           = CH.FillCol
            h.OutlineColor        = CH.OutCol
            h.FillTransparency    = CH.FillAlpha
            h.OutlineTransparency = CH.OutAlpha
            h.DepthMode           = CH.WallCheck and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
            h.Adornee             = char
            pcall(function() h.Parent = char end)
            Highlights[char] = h
        else
            local h = Highlights[char]
            h.FillColor           = CH.FillCol
            h.OutlineColor        = CH.OutCol
            h.FillTransparency    = CH.FillAlpha
            h.OutlineTransparency = CH.OutAlpha
            h.DepthMode           = CH.WallCheck and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
        end
    end

    S2:Toggle({ Name = "Enabled", Flag = "CH_On", Default = false,
        Callback = function(v)
            CH.On = v
            if not v then
                for _, p in Players:GetPlayers() do
                    if p.Character then ApplyHL(p.Character, false) end
                end
            end
        end })
    S2:Toggle({ Name = "Wall Check (hide thru walls)", Flag = "CH_WallChk", Default = false,
        Callback = function(v) CH.WallCheck = v end })
    S2:Toggle({ Name = "Team Check", Flag = "CH_Team", Default = false, Callback = function(v) CH.Team = v end })
    S2:Slider({ Name = "Fill Transparency", Flag = "CH_FillA", Min = 0, Max = 100, Default = 50, Suffix = "%",
        Callback = function(v) CH.FillAlpha = v/100 end })
    S2:Slider({ Name = "Outline Transparency", Flag = "CH_OutA", Min = 0, Max = 100, Default = 0, Suffix = "%",
        Callback = function(v) CH.OutAlpha = v/100 end })
    S2:Toggle({ Name = "Fill Colour", Flag = "_CHF" }):Colorpicker({ Name = "Fill", Flag = "CH_FC",
        Default = Color3.fromRGB(75,156,211), Alpha = 0, Callback = function(c) CH.FillCol = c end })
    S2:Toggle({ Name = "Outline Colour", Flag = "_CHO" }):Colorpicker({ Name = "Outline", Flag = "CH_OC",
        Default = Color3.fromRGB(255,255,255), Alpha = 0, Callback = function(c) CH.OutCol = c end })
    S2:Label("AlwaysOnTop = visible through walls", "Left")

    RunService.Heartbeat:Connect(function()
        if not CH.On then return end
        for _, p in Players:GetPlayers() do
            if p == LP then continue end
            if CH.Team and p.Team == LP.Team then
                if p.Character then ApplyHL(p.Character, false) end
                continue
            end
            if p.Character then ApplyHL(p.Character, true) end
        end
    end)

    -- Clean up when players leave
    Players.PlayerRemoving:Connect(function(p)
        if p.Character then ApplyHL(p.Character, false) end
    end)

    -- Crosshair + FOV
    local S3 = P.Visuals:Section({ Name = "Crosshair / FOV", Icon = "", Side = 1 })
    local CXL = {}
    for i = 1,4 do CXL[i] = Drawing.new("Line"); CXL[i].Thickness = 1.5; CXL[i].Color = Color3.fromRGB(255,255,255); CXL[i].Visible = false end
    S3:Toggle({ Name = "Custom Crosshair", Flag = "CX_On", Default = false,
        Callback = function(v) for _, l in CXL do l.Visible = v end end
    }):Colorpicker({ Name = "Colour", Flag = "CX_Col", Default = Color3.fromRGB(255,255,255), Alpha = 0,
        Callback = function(c) for _, l in CXL do l.Color = c end end })
    S3:Slider({ Name = "Gap",    Flag = "CX_Gap", Min = 0, Max = 20, Default = 4 })
    S3:Slider({ Name = "Length", Flag = "CX_Len", Min = 4, Max = 30, Default = 10 })
    S3:Slider({ Name = "Thickness", Flag = "CX_Thick", Min = 1, Max = 5, Default = 2,
        Callback = function(v) for _, l in CXL do l.Thickness = v end end })
    RunService.RenderStepped:Connect(function()
        if not Options["CX_On"]:Get() then return end
        local cx = Camera.ViewportSize.X/2; local cy = Camera.ViewportSize.Y/2
        local g = Options["CX_Gap"]:Get(); local l = Options["CX_Len"]:Get()
        CXL[1].From=Vector2.new(cx-g-l,cy); CXL[1].To=Vector2.new(cx-g,cy)
        CXL[2].From=Vector2.new(cx+g,cy);   CXL[2].To=Vector2.new(cx+g+l,cy)
        CXL[3].From=Vector2.new(cx,cy-g-l); CXL[3].To=Vector2.new(cx,cy-g)
        CXL[4].From=Vector2.new(cx,cy+g);   CXL[4].To=Vector2.new(cx,cy+g+l)
    end)
    local origFOV = Camera.FieldOfView
    S3:Toggle({ Name = "Custom FOV", Flag = "FOV_On", Default = false,
        Callback = function(v) Camera.FieldOfView = v and Options["FOV_Val"]:Get() or origFOV end })
    S3:Slider({ Name = "Field of View", Flag = "FOV_Val", Min = 30, Max = 120, Default = 90, Suffix = "°",
        Callback = function(v) if Options["FOV_On"]:Get() then Camera.FieldOfView = v end end })
end

