    RunService.RenderStepped:Connect(function()
        local ox, oy = GetAimOrigin()
        if AB.CircOn and FOVCirclesVisible then AB_Circle.Position = Vector2.new(ox, oy); AB_Circle.Radius = AB.FOV; AB_Circle.Visible = true elseif not FOVCirclesVisible then AB_Circle.Visible = false end
        if not AB.On or AB_KODead then return end
        do
            local kb = Options["AB_Key"]
            if kb and kb.Value ~= "" and kb.Value ~= "None" and not kb.Toggled then return end
        end

        -- KO / Sticky target management
        if AB.KOCheck and AB_KOTarget then
            local h = AB_KOTarget.Parent and AB_KOTarget.Parent:FindFirstChildOfClass("Humanoid")
            if not h or h.Health <= 0 then AB_KODead = true; AB_KOTarget = nil; return end
        end

        local target
        if AB.Sticky then
            if AB.StickyTarget then
                local char = AB.StickyTarget.Parent
                local h = char and char:FindFirstChildOfClass("Humanoid")
                local sp, vis = Camera:WorldToViewportPoint(AB.StickyTarget.Position)
                local d = Vector2.new(sp.X - ox, sp.Y - oy).Magnitude
                if not h or h.Health <= 0 or not vis or d > AB.FOV * 2.5 then AB.StickyTarget = nil end
            end
            if not AB.StickyTarget then AB.StickyTarget = NearestTarget(AB.FOV, AB.Hitpart, AB.Team, AB.NPC, ox, oy) end
            target = AB.StickyTarget
        elseif AB.KOCheck and AB_KOTarget then
            target = AB_KOTarget
        else
            target = NearestTarget(AB.FOV, AB.Hitpart, AB.Team, AB.NPC, ox, oy)
        end
        if not target then return end

        if AB.VisChk then
            local myHRP = HRP()
            if myHRP then
                local rp = RaycastParams.new(); rp.FilterDescendantsInstances = {LP.Character}; rp.FilterType = Enum.RaycastFilterType.Exclude
                local res = Workspace:Raycast(myHRP.Position, (target.Position - myHRP.Position), rp)
                if res and not target.Parent:IsAncestorOf(res.Instance) then return end
            end
        end
        local vel = target.AssemblyLinearVelocity or Vector3.zero
        local pred = target.Position + vel * (AB.Pred * 0.016)
        local sp, vis = Camera:WorldToViewportPoint(pred)
        if not vis then return end
        mousemoverel((sp.X - ox) / AB.Smooth, (sp.Y - oy) / AB.Smooth)
    end)

