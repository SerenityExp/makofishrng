-- ═══════════════════════════════════════════════════════════════
do
    -- ── ESP flags ─────────────────────────────────────────────
    local EF = {
        On = false, NPC = false, BoxType = "Corner Box",
        Name = true, Health = true, Dist = true,
        Tracer = false, Skeleton = false, HeadCircle = false, Weapon = false, FilledBox = false,
        Team = false, MaxDist = 1200,
        ECol = Color3.fromRGB(75,156,211), TCol = Color3.fromRGB(80,220,80),
        SnapOrigin = "Bottom",
    }

    -- R15 bone pairs
    local BONES = {
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    }

    local ESPObjs = {}

    local function NewESPObj()
        local o = {
            CornerLines  = {},
            BoxLines     = {},
            FillBox      = Drawing.new("Square"),
            Name         = Drawing.new("Text"),
            Dist         = Drawing.new("Text"),
            HBar         = Drawing.new("Square"),
            HFill        = Drawing.new("Square"),
            Tracer       = Drawing.new("Line"),
            HeadCircle   = Drawing.new("Circle"),
            Skeleton     = {},
            Weapon       = Drawing.new("Text"),
        }
        for i = 1,8  do local l = Drawing.new("Line"); l.Visible = false; l.Thickness = 1.8; o.CornerLines[i] = l end
        for i = 1,4  do local l = Drawing.new("Line"); l.Visible = false; l.Thickness = 1.5; o.BoxLines[i] = l end
        for i = 1,14 do local l = Drawing.new("Line"); l.Visible = false; l.Thickness = 1; l.Color = Color3.fromRGB(255,255,255); o.Skeleton[i] = l end
        o.FillBox.Visible = false; o.FillBox.Filled = true; o.FillBox.Thickness = 0; o.FillBox.Transparency = 0.7
        o.Name.Visible = false; o.Name.Size = 13; o.Name.Font = 2; o.Name.Center = true; o.Name.Outline = true
        o.Dist.Visible = false; o.Dist.Size = 11; o.Dist.Font = 2; o.Dist.Center = true; o.Dist.Outline = true; o.Dist.Color = Color3.fromRGB(190,190,190)
        o.HBar.Visible = false; o.HBar.Filled = true; o.HBar.Color = Color3.fromRGB(15,15,15)
        o.HFill.Visible = false; o.HFill.Filled = true
        o.Tracer.Visible = false; o.Tracer.Thickness = 1
        o.HeadCircle.Visible = false; o.HeadCircle.Thickness = 1.2; o.HeadCircle.Filled = false; o.HeadCircle.NumSides = 32
        o.Weapon.Visible = false; o.Weapon.Size = 11; o.Weapon.Font = 2; o.Weapon.Center = true; o.Weapon.Outline = true; o.Weapon.Color = Color3.fromRGB(220,220,100)
        return o
    end

    local function DestroyESP(o)
        if not o then return end
        local function killD(v)
            if type(v)=="userdata" then pcall(function() v:Remove() end)
            elseif type(v)=="table" then for _,x in v do killD(x) end end
        end
        for _,v in o do killD(v) end
    end

    local function HideESP(o)
        if not o then return end
        for _, l in ipairs(o.CornerLines) do l.Visible = false end
        for _, l in ipairs(o.BoxLines)    do l.Visible = false end
        for _, l in ipairs(o.Skeleton)   do l.Visible = false end
        o.FillBox.Visible    = false
        o.Name.Visible       = false
        o.Dist.Visible       = false
        o.HBar.Visible       = false
        o.HFill.Visible      = false
        o.Tracer.Visible     = false
        o.HeadCircle.Visible = false
        o.Weapon.Visible     = false
    end

    -- Manage ESP objects on player add/remove
    Players.PlayerAdded:Connect(function(p)
        if p ~= LP then task.wait(0.5); ESPObjs[p] = NewESPObj() end
    end)
    Players.PlayerRemoving:Connect(function(p)
        if ESPObjs[p] then
            HideESP(ESPObjs[p])
            task.defer(function()
                local o = ESPObjs[p]
                if not o then return end
                for _, l in o.CornerLines do pcall(function() l:Remove() end) end
                for _, l in o.BoxLines    do pcall(function() l:Remove() end) end
                for _, l in o.Skeleton   do pcall(function() l:Remove() end) end
                for _, k in {"FillBox","Name","Dist","HBar","HFill","Tracer","HeadCircle","Weapon"} do
                    pcall(function() o[k]:Remove() end)
                end
                ESPObjs[p] = nil
            end)
        end
    end)
    task.spawn(function()
        for _, p in Players:GetPlayers() do
            if p ~= LP then ESPObjs[p] = NewESPObj(); task.wait() end
        end
    end)

    RunService.RenderStepped:Connect(function()
        if not EF.On then
            for _, o in pairs(ESPObjs) do HideESP(o) end
            return
        end

        local myHRP = HRP()
        local cx = Camera.ViewportSize.X / 2
        local cy = Camera.ViewportSize.Y

        for p, o in pairs(ESPObjs) do
            if not p or not p.Parent then HideESP(o); continue end
            local char = p.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")

            local active = char and hrp and hum and hum.Health > 0
            if EF.Team and active and p.Team == LP.Team then active = false end
            if active and myHRP and (myHRP.Position - hrp.Position).Magnitude > EF.MaxDist then active = false end
            if not active then HideESP(o); continue end

            local col  = (p.Team ~= LP.Team) and EF.ECol or EF.TCol
            local head = char:FindFirstChild("Head")
            local topP = (head or hrp).Position + Vector3.new(0, head and 0.6 or 2.5, 0)
            local botP = hrp.Position - Vector3.new(0, 3, 0)

            local tSP, tVis = Camera:WorldToViewportPoint(topP)
            local bSP, bVis = Camera:WorldToViewportPoint(botP)
            local vw = Camera.ViewportSize.X; local vh = Camera.ViewportSize.Y
            if not tVis or not bVis or tSP.Z < 0
            or tSP.X < -200 or tSP.X > vw+200 or tSP.Y < -200 or tSP.Y > vh+200 then
                HideESP(o); continue
            end

            local bx = math.min(tSP.X, bSP.X)
            local by = math.min(tSP.Y, bSP.Y)
            local bw = math.abs(tSP.X - bSP.X) + 40  -- width from bounding
            local bh = math.abs(tSP.Y - bSP.Y)
            bx = tSP.X - bw / 2  -- centre

            -- ── Corner Box ───────────────────────────────────
            local showCorner = EF.BoxType == "Corner Box" or EF.BoxType == "Both"
            local showFull   = EF.BoxType == "Full Box"   or EF.BoxType == "Both"
            local cl = bw * 0.22  -- corner segment length

            for _, l in o.CornerLines do l.Visible = false end
            if showCorner then
                local cv = o.CornerLines
                local V = Vector2.new
                cv[1].Visible = true; cv[1].Color = col; cv[1].From = V(bx,by);       cv[1].To = V(bx+cl,by)
                cv[2].Visible = true; cv[2].Color = col; cv[2].From = V(bx,by);       cv[2].To = V(bx,by+cl)
                cv[3].Visible = true; cv[3].Color = col; cv[3].From = V(bx+bw,by);    cv[3].To = V(bx+bw-cl,by)
                cv[4].Visible = true; cv[4].Color = col; cv[4].From = V(bx+bw,by);    cv[4].To = V(bx+bw,by+cl)
                cv[5].Visible = true; cv[5].Color = col; cv[5].From = V(bx,by+bh);    cv[5].To = V(bx+cl,by+bh)
                cv[6].Visible = true; cv[6].Color = col; cv[6].From = V(bx,by+bh);    cv[6].To = V(bx,by+bh-cl)
                cv[7].Visible = true; cv[7].Color = col; cv[7].From = V(bx+bw,by+bh); cv[7].To = V(bx+bw-cl,by+bh)
                cv[8].Visible = true; cv[8].Color = col; cv[8].From = V(bx+bw,by+bh); cv[8].To = V(bx+bw,by+bh-cl)
            end

            for _, l in o.BoxLines do l.Visible = false end
            if showFull then
                local bv = o.BoxLines
                local V = Vector2.new
                bv[1].Visible = true; bv[1].Color = col; bv[1].From = V(bx,by);       bv[1].To = V(bx+bw,by)
                bv[2].Visible = true; bv[2].Color = col; bv[2].From = V(bx+bw,by);    bv[2].To = V(bx+bw,by+bh)
                bv[3].Visible = true; bv[3].Color = col; bv[3].From = V(bx+bw,by+bh); bv[3].To = V(bx,by+bh)
                bv[4].Visible = true; bv[4].Color = col; bv[4].From = V(bx,by+bh);    bv[4].To = V(bx,by)
            end

            -- ── Filled Box ───────────────────────────────────
            o.FillBox.Visible = EF.FilledBox
            if EF.FilledBox then
                o.FillBox.Color = col; o.FillBox.Size = Vector2.new(bw,bh); o.FillBox.Position = Vector2.new(bx,by)
            end

            -- ── Name ─────────────────────────────────────────
            o.Name.Visible = EF.Name
            if EF.Name then
                o.Name.Text = p.Name; o.Name.Color = Color3.new(1,1,1)
                o.Name.Position = Vector2.new(bx + bw/2, by - 15)
            end

            -- ── Distance ─────────────────────────────────────
            o.Dist.Visible = EF.Dist and myHRP ~= nil
            if EF.Dist and myHRP then
                o.Dist.Text = math.floor((myHRP.Position - hrp.Position).Magnitude) .. "m"
                o.Dist.Position = Vector2.new(bx + bw/2, by + bh + 2)
            end

            -- ── Health Bar ───────────────────────────────────
            if EF.Health and hum then
                local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local hc  = Color3.fromRGB((1-pct)*255, pct*200, 0)
                o.HBar.Visible  = true; o.HFill.Visible  = true
                o.HBar.Size     = Vector2.new(3, bh)
                o.HBar.Position = Vector2.new(bx - 5, by)
                o.HFill.Color   = hc
                o.HFill.Size    = Vector2.new(3, bh * pct)
                o.HFill.Position = Vector2.new(bx - 5, by + bh * (1 - pct))
            else o.HBar.Visible = false; o.HFill.Visible = false end

            -- ── Tracer ───────────────────────────────────────
            o.Tracer.Visible = EF.Tracer
            if EF.Tracer then
                local originY = EF.SnapOrigin == "Middle" and Camera.ViewportSize.Y/2 or cy
                o.Tracer.Color = col; o.Tracer.Thickness = 1
                o.Tracer.From = Vector2.new(cx, originY)
                o.Tracer.To   = Vector2.new(bx + bw/2, by + bh)
            end

            -- ── Head Circle ──────────────────────────────────
            if EF.HeadCircle and head then
                local hSP, hVis = Camera:WorldToViewportPoint(head.Position)
                o.HeadCircle.Visible = hVis
                if hVis then
                    o.HeadCircle.Color = col
                    o.HeadCircle.Position = Vector2.new(hSP.X, hSP.Y)
                    o.HeadCircle.Radius  = bh * 0.12
                end
            else o.HeadCircle.Visible = false end

            -- ── Skeleton ─────────────────────────────────────
            for i, l in o.Skeleton do l.Visible = false end
            if EF.Skeleton then
                for i, pair in BONES do
                    local a = char:FindFirstChild(pair[1])
                    local b = char:FindFirstChild(pair[2])
                    if not a or not b then o.Skeleton[i].Visible = false; continue end
                    local aSP, aVis = Camera:WorldToViewportPoint(a.Position)
                    local bSP, bVis = Camera:WorldToViewportPoint(b.Position)
                    if aVis and bVis then
                        o.Skeleton[i].Visible = true
                        o.Skeleton[i].Color = col
                        o.Skeleton[i].From = Vector2.new(aSP.X, aSP.Y)
                        o.Skeleton[i].To   = Vector2.new(bSP.X, bSP.Y)
                    else o.Skeleton[i].Visible = false end
                end
            end

            -- ── Weapon / Tool ────────────────────────────────
            if EF.Weapon then
                local tool = char:FindFirstChildOfClass("Tool")
                o.Weapon.Visible = tool ~= nil
                if tool then
                    o.Weapon.Text = tool.Name
                    o.Weapon.Position = Vector2.new(bx + bw/2, by - 26)
                end
            else o.Weapon.Visible = false end
        end
    end)

    -- NPC ESP (simple corner boxes for workspace humanoid models)
    local NPCObjs = {}
    RunService.Heartbeat:Connect(function()
        if not EF.NPC then
            for key, o in pairs(NPCObjs) do HideESP(o); NPCObjs[key] = nil end
            return
        end
        local myHRP = HRP()
        -- Remove stale NPC entries
        for key, _ in pairs(NPCObjs) do
            if not Workspace:FindFirstChild(key) then HideESP(NPCObjs[key]); NPCObjs[key] = nil end
        end
        -- Add new NPC entries
        for _, model in ipairs(Workspace:GetChildren()) do
            if not model:IsA("Model") then continue end
            if Players:GetPlayerFromCharacter(model) then continue end
            local hum = model:FindFirstChildOfClass("Humanoid"); if not hum then continue end
            if not NPCObjs[model.Name] then NPCObjs[model.Name] = NewESPObj() end
        end
    end)

    RunService.RenderStepped:Connect(function()
        if not EF.NPC then return end
        local myHRP = HRP()
        local cx = Camera.ViewportSize.X / 2
        for name, o in pairs(NPCObjs) do
            local model = Workspace:FindFirstChild(name)
            if not model then HideESP(o); continue end
            local hrp = model:FindFirstChild("HumanoidRootPart")
            local hum = model:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then HideESP(o); continue end
            if myHRP and (myHRP.Position - hrp.Position).Magnitude > EF.MaxDist then HideESP(o); continue end
            local head = model:FindFirstChild("Head")
            local topP = (head or hrp).Position + Vector3.new(0, head and 0.6 or 2.5, 0)
            local botP = hrp.Position - Vector3.new(0, 3, 0)
            local tSP, tVis = Camera:WorldToViewportPoint(topP)
            local bSP, bVis = Camera:WorldToViewportPoint(botP)
            if not tVis or not bVis or tSP.Z < 0 then HideESP(o); continue end
            local col = Color3.fromRGB(255, 120, 40)
            local bw = math.abs(tSP.X - bSP.X) + 40
            local bh = math.abs(tSP.Y - bSP.Y)
            local bx = tSP.X - bw / 2
            local by = math.min(tSP.Y, bSP.Y)
            local cl = bw * 0.22
            local cv = o.CornerLines; local V = Vector2.new
            for _, l in ipairs(cv) do l.Visible = false end
            cv[1].Visible=true; cv[1].Color=col; cv[1].From=V(bx,by);       cv[1].To=V(bx+cl,by)
            cv[2].Visible=true; cv[2].Color=col; cv[2].From=V(bx,by);       cv[2].To=V(bx,by+cl)
            cv[3].Visible=true; cv[3].Color=col; cv[3].From=V(bx+bw,by);    cv[3].To=V(bx+bw-cl,by)
            cv[4].Visible=true; cv[4].Color=col; cv[4].From=V(bx+bw,by);    cv[4].To=V(bx+bw,by+cl)
            cv[5].Visible=true; cv[5].Color=col; cv[5].From=V(bx,by+bh);    cv[5].To=V(bx+cl,by+bh)
            cv[6].Visible=true; cv[6].Color=col; cv[6].From=V(bx,by+bh);    cv[6].To=V(bx,by+bh-cl)
            cv[7].Visible=true; cv[7].Color=col; cv[7].From=V(bx+bw,by+bh); cv[7].To=V(bx+bw-cl,by+bh)
            cv[8].Visible=true; cv[8].Color=col; cv[8].From=V(bx+bw,by+bh); cv[8].To=V(bx+bw,by+bh-cl)
            o.Name.Visible = true; o.Name.Text = model.Name
            o.Name.Color = col; o.Name.Position = V(bx + bw/2, by - 15)
        end
    end)

    -- ESP UI
    local S1 = P.Visuals:Section({ Name = "ESP", Icon = "", Side = 1 })
