local function NearestTarget(fov, hitpart, teamChk, npcChk, originX, originY)
    local myHRP = HRP(); if not myHRP then return nil end
    local best, bestD = nil, fov
    local ox = originX or (Camera.ViewportSize.X / 2)
    local oy = originY or (Camera.ViewportSize.Y / 2)

    local function checkPart(part, pos)
        local sp, vis = Camera:WorldToViewportPoint(pos)
        if not vis then return end
        local d = Vector2.new(sp.X - ox, sp.Y - oy).Magnitude
        if d < bestD then best = part; bestD = d end
    end

    for _, p in Players:GetPlayers() do
        if p == LP then continue end
        if teamChk and p.Team == LP.Team then continue end
        local char = p.Character; if not char then continue end
        local h = char:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then continue end
        local part = char:FindFirstChild(hitpart) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        checkPart(part, part.Position)
    end

    if npcChk then
        for _, model in ipairs(Workspace:GetChildren()) do
            if not model:IsA("Model") then continue end
            if Players:GetPlayerFromCharacter(model) then continue end
            local h = model:FindFirstChildOfClass("Humanoid")
            if not h or h.Health <= 0 then continue end
            local hrp = model:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end
            local part = model:FindFirstChild(hitpart) or hrp
            if not part then continue end
            local myPos = myHRP.Position
            if (myPos - hrp.Position).Magnitude > 1000 then continue end
            checkPart(part, part.Position)
        end
    end

    return best
end

