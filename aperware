            if not v then
                Camera.CameraType = Enum.CameraType.Custom
                local hum = Hum()
                if hum then Camera.CameraSubject = hum end
            end
        end })
    local function RefreshSpecList()
        local t = {}
        for _, p in Players:GetPlayers() do if p ~= LP then t[#t+1] = p.Name end end
        return t
    end
    S3:Dropdown({ Name = "Target", Flag = "Spec_Tgt",
        Items = RefreshSpecList(), Default = nil,
        Callback = function(v)
            SpecTarget = v and Players:FindFirstChild(v) or nil
        end })

    RunService.RenderStepped:Connect(function()
        if not SpecOn or not SpecTarget then return end
        if not SpecTarget.Parent then SpecTarget = nil; Camera.CameraType = Enum.CameraType.Custom; return end
        local char = SpecTarget.Character; if not char then return end
        local h = char:FindFirstChildOfClass("Humanoid"); if not h then return end
        Camera.CameraType = Enum.CameraType.Watch
        Camera.CameraSubject = h
    end)

    Players.PlayerRemoving:Connect(function(p)
        if SpecTarget == p then
            SpecTarget = nil
            Camera.CameraType = Enum.CameraType.Custom
            Library:Notification({ Name = "aperWare", Description = p.Name .. " left — spectate stopped", Duration = 3 })
        end
    end)
end

