        local saved = myHRP.CFrame
        myHRP.CFrame = CFrame.new(tgt.Position + (myHRP.Position - tgt.Position).Unit * (RE.Range - 1))
        task.wait(0.15)
        if HRP() then HRP().CFrame = saved end
    end)
    S6:Label("Briefly teleports toward target on LMB", "Left")
